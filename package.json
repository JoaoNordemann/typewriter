{
  "name": "typewriter",
  "version": "1.1.0",
  "private": true,
  "description": "Uma pequena máquina de escrever pixelada para planos em Markdown",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:electron": "node test/electron.cjs",
    "build:win": "electron --version && electron-builder --win portable --x64",
    "package:win": "npm run build:win && powershell -NoProfile -File scripts/package.ps1",
    "test:portable": "node test/portable-smoke.cjs",
    "test:regions": "node test/input-regions.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.2.7"
  },
  "author": "Typewriter",
  "build": {
    "appId": "io.typewriter.desktop",
    "productName": "Typewriter",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "records.js",
      "index.html",
      "style.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "materiais",
        "to": "materiais"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Typewriter-${version}-portatil.exe"
    },
    "electronDist": "node_modules/electron/dist",
    "compression": "normal"
  }
}
